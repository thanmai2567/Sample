<!DOCTYPE html>
<html>
<head>
  <title>User Table</title>
  <style>
    table, th, td {
      border: 1px solid black;
      border-collapse: collapse;
      padding: 10px;
    }
  </style>
</head>
<body>
  <h1>User List</h1>
  <table>
    <tr>
      <th>ID</th><th>Name</th><th>Email</th>
    </tr>
    <% users.forEach(user => { %>
      <tr>
        <td><%= user.id %></td>
        <td><%= user.name %></td>
        <td><%= user.email %></td>
      </tr>
    <% }); %>
  </table>
</body>
</html>
